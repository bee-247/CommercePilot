# Shared model provider
ARK_API_KEY=
BASE_URL=
MODEL=
GRADE_MODEL=

# Sales recommendation model (pydantic settings use the ECOM_ prefix)
ECOM_LLM_API_KEY=
ECOM_LLM_BASE_URL=
ECOM_LLM_MODEL=
ECOM_EMBEDDING_API_KEY=
ECOM_EMBEDDING_BASE_URL=
ECOM_EMBEDDING_MODEL=text-embedding-3-small
ECOM_EMBEDDING_DIMENSION=1536
ECOM_RAG_AUGMENTATION_ENABLED=true
ECOM_RAG_AUGMENTATION_TOP_K=4
ECOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000
ECOM_ADMIN_USERNAME=admin
ECOM_ADMIN_PASSWORD=
ECOM_MAX_UPLOAD_MB=50
ECOM_MAX_IMAGE_UPLOAD_MB=10
ECOM_SEED_DEMO_DATA=true

# Sales databases
ECOM_DATABASE_URL=sqlite:///./data/ecommerce.db
ECOM_PRODUCT_DATABASE_URL=
ECOM_USER_DATABASE_URL=

# RAG database and cache
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/commerce_pilot
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=commerce-pilot
REDIS_CACHE_TTL_SECONDS=300

# Sales Milvus collections
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530
ECOM_MILVUS_PRODUCT_COLLECTION=product_embeddings
ECOM_MILVUS_USER_COLLECTION=user_embeddings

# Customer-service knowledge-base Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=customer_service_documents

# Local dense embedding and BM25
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
BM25_STATE_PATH=./data/bm25_state.json

# Optional reranker
RERANK_MODEL=
RERANK_API_KEY=
RERANK_BINDING_HOST=
