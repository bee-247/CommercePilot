# 文本模型：用于翻译、对话、规划、审核和客服 RAG 查询改写
# 每项必须独立填写，不引用其他模型的配置
# 只需在下一行填写智谱开放平台 API Key
TEXT_API_KEY=
TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TEXT_LLM=glm-5.2

# 视觉模型：只用于图片理解
# 即使与文本模型属于同一服务商，也请独立填写密钥和地址
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_LLM=qwen-vl-max

# 向量模型：用于商品、用户、知识库文档及查询文本的向量化
# 向量维度必须与模型实际返回的维度一致
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10

# 重排序模型：优先读取本地模型目录，不会自动联网下载
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_PATH=model/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
# 仅使用远程重排序服务时填写；本地模式不需要 API Key 和 URL
RERANK_API_KEY=
RERANK_BASE_URL=

ECOM_RAG_AUGMENTATION_ENABLED=true
ECOM_RAG_AUGMENTATION_TOP_K=4
# Agent、Broker 和编排的静态配置文件
ECOM_AGENT_CONFIG_FILE=config/agents.yaml
ECOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 身份认证
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_PBKDF2_ROUNDS=310000
ECOM_ADMIN_USERNAME=admin
ECOM_ADMIN_PASSWORD=
ECOM_MAX_UPLOAD_MB=50
ECOM_MAX_IMAGE_UPLOAD_MB=10
ECOM_SEED_DEMO_DATA=true

# 销售业务数据库
ECOM_DATABASE_URL=sqlite:///data/ecommerce.db
ECOM_PRODUCT_DATABASE_URL=
ECOM_USER_DATABASE_URL=

# RAG 数据库与缓存
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/commerce_pilot
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=commerce-pilot
REDIS_CACHE_TTL_SECONDS=300

# 销售业务的 Milvus 集合
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530
ECOM_MILVUS_PRODUCT_COLLECTION=product_embeddings
ECOM_MILVUS_USER_COLLECTION=user_embeddings

# 客服知识库的 Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=customer_service_documents

# BM25 统计文件；程序会自动附加向量配置标识
BM25_STATE_PATH=data/bm25_state.json
